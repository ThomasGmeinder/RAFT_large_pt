FROM mcr.microsoft.com/devcontainers/python:3.12-bookworm

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# This network intercepts TLS with the AMD issuing CA. Without it, curl
# cannot download uv (SSL certificate problem: unable to get local issuer).
COPY .devcontainer/certs/amd-com-issuing-ca.crt /usr/local/share/ca-certificates/amd-com-issuing-ca.crt
RUN update-ca-certificates

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        wget \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_INSTALL_DIR=/usr/local/bin \
    UV_LINK_MODE=copy

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Named volumes are mounted at ~/.cache/torch and ~/.cache/uv. Docker creates
# missing mount points and parents as root, which blocks the vscode user.
# The uv volume and the bind-mounted workspace are separate mounts, so uv
# cannot hardlink between them (UV_LINK_MODE=copy above).
RUN mkdir -p /home/vscode/.cache/torch /home/vscode/.cache/uv \
    && chown -R vscode:vscode /home/vscode/.cache

WORKDIR /workspaces/RAFT_large_pt

CMD ["sleep", "infinity"]
